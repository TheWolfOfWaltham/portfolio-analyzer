# Massive API key (Stocks Basic or higher). Set the same name in Railway → Variables.
MASSIVE_API_KEY=
# 5 on Stocks Basic. Set 0 on Starter or above to remove the rate limiter.
MASSIVE_CALLS_PER_MIN=5
# Optional: a Railway volume mount path so the price cache survives redeploys, e.g. /data
CACHE_DIR=
# Optional
ANTHROPIC_API_KEY=
